{
  "name": "dsh-astrbot-bridge",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Token-protected HTTP bridge and relay tunnel that let AstrBot drive DeepSeek Harness sessions.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "relay-server.mjs",
    "README.md"
  ],
  "scripts": {
    "test": "node test/cordis-load.mjs && node test/api-e2e.mjs && node test/client-render.mjs && node test/relay-e2e.mjs",
    "relay": "node relay-server.mjs --port 9443",
    "preview": "node test/preview-render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "author": "umeabc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeabc/dsh-astrbot-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/umeabc/dsh-astrbot-bridge/issues"
  },
  "homepage": "https://github.com/umeabc/dsh-astrbot-bridge#readme"
}
